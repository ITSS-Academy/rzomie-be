{
  "name": "minimalist",
  "displayName": "Minimalist",
  "description": "A minimalist resume theme with clean lines, elegant typography, and a clear two-column layout. Designed for modern professionals who prefer simplicity, clarity, and focus on content.",
  "author": "FormCV",
  "version": "1.0.0",
  "preview": "preview.png",
  "category": "modern",
  "sectionOrder": [
    "personal",
    "summary",
    "experience",
    "education",
    "skills",
    "projects",
    "languages",
    "awards",
    "courses",
    "organizations",
    "publications",
    "interests",
    "references",
    "customSections",
    "declaration"
  ],
  "css": {
    "fonts": {
      "primary": "Roboto Slab, serif",
      "heading": "Roboto Slab, serif",
      "monospace": "Courier New, monospace"
    },
    "fontSizes": {
      "base": "14px",
      "small": "12px",
      "large": "16px",
      "heading": "48px",
      "sectionTitle": "18px",
      "itemTitle": "16px",
      "body": "14px",
      "h1": "28px",
      "h2": "18px"
    },
    "fontWeights": {
      "normal": 400,
      "bold": 700,
      "medium": 500
    },
    "colors": {
      "primary": "#000000",
      "secondary": "#666666",
      "background": "#ffffff",
      "surface": "#ffffff",
      "accent": "#000000",
      "text": "#000000",
      "muted": "#666666"
    },
    "defaultSelectedElements": [],
    "defaultAppliedColors": {},
    "elementColors": {},
    "spacing": {
      "lineHeight": "1.5",
      "section": "30px",
      "item": "20px",
      "container": "40px",
      "line": "1.5"
    },
    "padding": {
      "container": "40px",
      "section": "18px",
      "item": "10px"
    },
    "customization": {
      "fontSize": {
        "type": "relative",
        "min": 0,
        "max": 10,
        "step": 1,
        "default": 0,
        "unit": "px",
        "scaling": {
          "enabled": true,
          "description": "When font size is changed, all font sizes will be adjusted proportionally"
        }
      },
      "fontWeight": {
        "type": "absolute",
        "min": 400,
        "max": 800,
        "step": 100,
        "default": 400
      },
      "sectionSpacing": {
        "type": "relative",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0,
        "unit": "px"
      },
      "itemSpacing": {
        "type": "relative",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0,
        "unit": "px"
      },
      "lineSpacing": {
        "type": "relative",
        "min": 1,
        "max": 2.5,
        "step": 0.1,
        "default": 1.5,
        "unit": "multiplier"
      },
      "accentColors": {
        "availableElements": [
          "Name",
          "Headings",
          "Header icons",
          "Dots/Bars/Bubbles",
          "Dates",
          "Link icons"
        ],
        "defaultSelectedElements": [],
        "defaultAppliedColors": {},
        "elementColors": {},
        "fontSize": "1px",
        "fontWeight": 400,
        "sectionSpacing": 0,
        "itemSpacing": 0,
        "lineSpacing": 1.5
      }
    },
    "lineHeights": {
      "base": 1.5,
      "heading": 1.2
    },
    "letterSpacing": {
      "base": "0.3px",
      "heading": "1px"
    },
    "margin": {
      "section": "24px",
      "item": "12px",
      "container": "0"
    },
    "gap": {
      "row": "12px",
      "column": "40px"
    },
    "grid": {
      "columns": "260px 1fr",
      "gap": "30px"
    },
    "borderRadius": {
      "small": "3px",
      "medium": "6px",
      "large": "8px"
    },
    "boxShadow": {
      "default": "none",
      "accent": "none"
    },
    "border": {
      "default": "1px solid #eeeeee",
      "accent": "2px solid #000000"
    }
  },
  "dateFormat": {
    "availableFormats": [
      "mm/dd/yyyy",
      "mm/yyyy",
      "yyyy"
    ],
    "defaultFormat": "mm/dd/yyyy",
    "description": "Date format options for CV display"
  },
  "dateFormatConfig": {
    "education": {
      "availableFormats": [
        "mm/dd/yyyy",
        "mm/yyyy",
        "yyyy"
      ],
      "defaultFormat": "mm/dd/yyyy"
    },
    "experience": {
      "availableFormats": [
        "mm/dd/yyyy",
        "mm/yyyy",
        "yyyy"
      ],
      "defaultFormat": "mm/dd/yyyy"
    },
    "projects": {
      "availableFormats": [
        "mm/dd/yyyy",
        "mm/yyyy",
        "yyyy"
      ],
      "defaultFormat": "mm/dd/yyyy"
    },
    "awards": {
      "availableFormats": [
        "mm/dd/yyyy",
        "mm/yyyy",
        "yyyy"
      ],
      "defaultFormat": "mm/dd/yyyy"
    },
    "organizations": {
      "availableFormats": [
        "mm/dd/yyyy",
        "mm/yyyy",
        "yyyy"
      ],
      "defaultFormat": "mm/dd/yyyy"
    },
    "publications": {
      "availableFormats": [
        "mm/dd/yyyy",
        "mm/yyyy",
        "yyyy"
      ],
      "defaultFormat": "mm/dd/yyyy"
    },
    "courses": {
      "availableFormats": [
        "mm/dd/yyyy",
        "mm/yyyy",
        "yyyy"
      ],
      "defaultFormat": "mm/dd/yyyy"
    }
  }
}