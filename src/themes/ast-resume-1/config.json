      "heading": "Roboto Slab, serif",
      "monospace": "Courier New, monospace"
    },
    "fontSizes": {
      "base": "13px",
      "small": "12px",
      "large": "14px",
      "heading": "40px",
      "sectionTitle": "20px",
      "itemTitle": "18px",
      "body": "13px",
      "h1": "40px",
      "h2": "20px"
    },
    "fontWeights": {
