{
  "name": "ast-resume-1",
  "displayName": "AST Resume 1",
  "description": "A bold, modern resume with colored header, underlined section titles, and Roboto Slab font. Inspired by classic ATS-friendly layouts.",
  "author": "FormCV",
  "version": "1.0.0",
  "preview": "preview.png",
  "category": "modern",
  "sectionOrder": [
    "personal",
    "summary",
    "experience",
    "education",
    "skills",
    "projects",
    "languages",
