{
  "name": "material",
  "displayName": "Material Modern",
  "description": "A modern, clean, magazine-style CV theme inspired by Google Material Design. Blue primary, deep orange secondary, Roboto font, card layout, and subtle shadows.",
  "author": "FormCV",
  "version": "1.0.0",
  "preview": "preview.png",
  "category": "professional",
  "sectionOrder": [
    "personal",
    "summary",
    "experience",
    "education",
    "skills",
    "projects",
    "languages",
    "awards",
    "courses",
    "organizations",
    "publications",
    "interests",
    "references",
    "customSections",
    "declaration"
  ],
  "css": {
    "fonts": {
      "primary": "Fira Mono, JetBrains Mono, Source Code Pro, monospace",
      "heading": "Fira Mono, JetBrains Mono, Source Code Pro, monospace",
      "monospace": "Fira Mono, JetBrains Mono, Source Code Pro, monospace"
    },
    "fontSizes": {
      "base": "16px",
      "small": "14px",
      "large": "20px",
      "heading": "40px",
      "sectionTitle": "20px",
      "itemTitle": "18px",
      "body": "16px",
      "h1": "40px",
      "h2": "20px"
    },
    "fontWeights": {
      "normal": 400,
      "bold": 700,
      "medium": 600
    },
    "spacing": {
      "lineHeight": "1.8",
      "section": "28px",
      "item": "18px",
      "container": "40px 20mm",
      "line": "1.8"
    },
    "padding": {
      "container": "40px 20mm"
    },
    "colors": {
      "primary": "#D1006F",
      "secondary": "#B8E7EA",
      "background": "#ffffff",
      "surface": "#ffffff",
      "accent": "#111111",
      "text": "#7B238A",
      "muted": "#666666"
    },
    "defaultSelectedElements": [],
    "defaultAppliedColors": {},
    "elementColors": {},
    "customization": {
      "fontSize": {
        "type": "relative",
        "min": 0,
        "max": 10,
        "step": 1,
        "default": 0,
        "unit": "px",
        "scaling": {
          "enabled": true,
          "description": "When font size is changed, all font sizes will be adjusted proportionally"
        }
      },
      "fontWeight": {
        "type": "absolute",
        "min": 400,
        "max": 800,
        "step": 100,
        "default": 400
      },
      "sectionSpacing": {
        "type": "relative",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0,
        "unit": "px"
      },
      "itemSpacing": {
        "type": "relative",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0,
        "unit": "px"
      },
      "lineSpacing": {
        "type": "relative",
        "min": 1,
        "max": 2.5,
        "step": 0.1,
        "default": 1.5,
        "unit": "multiplier"
      },
      "accentColors": {
        "availableElements": [
          "Name",
          "Headings",
          "Header icons",
          "Dots/Bars/Bubbles",
          "Dates",
          "Link icons"
        ],
        "defaultSelectedElements": [],
        "defaultAppliedColors": {},
        "elementColors": {},
        "fontSize": "1px",
        "fontWeight": 400,
        "sectionSpacing": 0,
        "itemSpacing": 0,
        "lineSpacing": 1.5
      }
    }
  },
  "dateFormat": {
    "availableFormats": [
      "mm/dd/yyyy",
      "mm/yyyy",
      "yyyy"
    ],
    "defaultFormat": "mm/dd/yyyy",
    "description": "Date format options for CV display"
  },
  "dateFormatConfig": {
    "education": {
