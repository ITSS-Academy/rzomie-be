{
  "name": "harvard-serif-2",
  "displayName": "Harvard Resume - Sans-Serif",
  "description": "Classic Harvard-style resume with serif font and clean section dividers.",
  "author": "FormCV",
  "version": "1.0.0",
  "preview": "preview.png",
  "category": "serif",
  "sectionOrder": [
    "personal",
    "summary",
    "experience",
    "education",
    "skills",
    "projects",
    "languages",
    "awards",
    "courses",
    "organizations",
    "publications",
    "interests",
    "references",
    "customSections",
    "declaration"
  ],
  "css": {
    "fonts": {
      "primary": "Roboto, sans-serif",
      "heading": "Roboto, sans-serif",
      "monospace": "Courier New, monospace"
    },
    "fontSizes": {
      "base": "13px",
      "small": "12px",
      "large": "18px",
      "heading": "32px",
      "sectionTitle": "16px",
      "itemTitle": "16px",
      "body": "13px",
      "h1": "32px",
      "h2": "16px"
    },
    "fontWeights": {
      "normal": 400,
      "bold": 700,
      "medium": 500
    },
    "colors": {
      "primary": "#000000",
      "secondary": "#555555",
      "background": "#ffffff",
      "surface": "#ffffff",
      "accent": "#000000",
      "text": "#000000",
      "muted": "#555555"
    },
    "spacing": {
      "lineHeight": "1.5",
      "section": "20px",
      "item": "15px",
      "container": "40px 32px",
      "line": "1.5"
    },
    "padding": {
      "container": "40px 32px"
    },
    "customization": {
      "fontSize": {
        "type": "relative",
        "min": 0,
        "max": 10,
        "step": 1,
        "default": 0,
        "unit": "px",
        "scaling": {
          "enabled": true,
          "description": "When font size is changed, all font sizes will be adjusted proportionally"
        }
      },
      "fontWeight": {
        "type": "absolute",
        "min": 400,
        "max": 800,
        "step": 100,
        "default": 400
      },
      "sectionSpacing": {
        "type": "relative",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0,
        "unit": "px"
      },
      "itemSpacing": {
        "type": "relative",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0,
        "unit": "px"
      },
      "lineSpacing": {
        "type": "relative",
        "min": 1,
        "max": 2.5,
        "step": 0.1,
        "default": 1.5,
        "unit": "multiplier"
      },
      "accentColors": {
        "availableElements": [
          "Name",
          "Headings",
          "Header icons",
          "Dots/Bars/Bubbles",
          "Dates",
          "Link icons"
        ],
        "defaultSelectedElements": [],
        "defaultAppliedColors": {},
        "elementColors": {},
        "fontSize": "1px",
        "fontWeight": 400,
        "sectionSpacing": 0,
        "itemSpacing": 0,
        "lineSpacing": 1.5
      }
    },
    "lineHeights": {
      "base": 1.7,
      "heading": 1.2
    },
    "border": {
      "default": "1px solid #000000"
    },
    "elementColors": {},
    "defaultSelectedElements": [],
    "defaultAppliedColors": {}
  },
  "dateFormat": {
    "availableFormats": [
      "mm/dd/yyyy",
      "mm/yyyy",
      "yyyy"
    ],
    "defaultFormat": "mm/dd/yyyy",
    "description": "Date format options for CV display"
  },
  "dateFormatConfig": {
    "education": {
      "availableFormats": [
        "mm/dd/yyyy",
        "mm/yyyy",
        "yyyy"
      ],
      "defaultFormat": "mm/dd/yyyy"
    },
    "experience": {
      "availableFormats": [
        "mm/dd/yyyy",
        "mm/yyyy",
        "yyyy"
      ],
      "defaultFormat": "mm/dd/yyyy"
    },
    "projects": {
      "availableFormats": [
        "mm/dd/yyyy",
        "mm/yyyy",
        "yyyy"
      ],
      "defaultFormat": "mm/dd/yyyy"
    },
    "awards": {
      "availableFormats": [
        "mm/dd/yyyy",
        "mm/yyyy",
        "yyyy"
      ],
      "defaultFormat": "mm/dd/yyyy"
    },
    "organizations": {
      "availableFormats": [
        "mm/dd/yyyy",
        "mm/yyyy",
        "yyyy"
      ],
      "defaultFormat": "mm/dd/yyyy"
    },
    "publications": {
      "availableFormats": [
        "mm/dd/yyyy",
        "mm/yyyy",
        "yyyy"
      ],
      "defaultFormat": "mm/dd/yyyy"
    },
    "courses": {
      "availableFormats": [
        "mm/dd/yyyy",
        "mm/yyyy",
        "yyyy"
      ],
      "defaultFormat": "mm/dd/yyyy"
    }
  }
}